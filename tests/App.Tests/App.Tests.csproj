<Project Sdk="Microsoft.NET.Sdk">

  <!-- Тесты программы: выгрузка результата, установщик (архив внутри файла), версии обновления,
       окно без экрана (Avalonia Headless) с настоящим прогоном на синтетических сканах.
       Снимки экранов: переменная DTR_SCREENS с папкой. Запуск: dotnet test tests/App.Tests -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>DocumentTextRecognition.App.Tests</RootNamespace>
    <AssemblyName>DocumentTextRecognition.App.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="11.2.3" />
    <PackageReference Include="Avalonia.Skia" Version="11.2.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\App\App.csproj" />
    <!-- Синтетические шаблоны и сканы из тестов ядра. -->
    <ProjectReference Include="..\Core.Tests\Core.Tests.csproj" />
  </ItemGroup>

</Project>
