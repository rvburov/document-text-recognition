<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:DocumentTextRecognition.Ui"
             xmlns:s="using:DocumentTextRecognition.Services"
             x:Class="DocumentTextRecognition.Pages.TemplatesPage">
  <Grid Margin="16,0,16,16" RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ui:Gap.Columns="8" Margin="0,16,0,12">
      <TextBlock Classes="h1" Text="Шаблоны" VerticalAlignment="Center" />
      <Button Grid.Column="1" Click="OnRefresh">
        <StackPanel Orientation="Horizontal" Spacing="8"><ui:Icon Kind="Refresh" /><TextBlock Text="Обновить" VerticalAlignment="Center" /></StackPanel>
      </Button>
      <Button Grid.Column="2" Click="OnOpenFolder">
        <StackPanel Orientation="Horizontal" Spacing="8"><ui:Icon Kind="Folder" /><TextBlock Text="Открыть папку" VerticalAlignment="Center" /></StackPanel>
      </Button>
      <Button Grid.Column="3" Click="OnHowTo">
        <StackPanel Orientation="Horizontal" Spacing="8"><ui:Icon Kind="BookOpen" /><TextBlock Text="Как сделать шаблон" VerticalAlignment="Center" /></StackPanel>
      </Button>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <TextBlock Name="FolderText" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource Brush.FrameDesignation}" /><TextBlock Classes="hint" Text="обозначение" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource Brush.FrameName}" /><TextBlock Classes="hint" Text="наименование" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource Brush.FrameType}" /><TextBlock Classes="hint" Text="тип документа" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5"><Border Width="12" Height="12" CornerRadius="2" Background="{DynamicResource Brush.FrameAll}" /><TextBlock Classes="hint" Text="все поля вместе" /></StackPanel>
      </StackPanel>
    </Grid>

    <!-- Папка не выбрана или пуста. -->
    <Border Name="Empty" Grid.Row="2" Classes="card" BorderBrush="{DynamicResource Brush.Line}" IsVisible="False">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="460">
        <TextBlock Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" TextAlignment="Center" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Шаблон: PDF-образец документа, где поля штампа обведены цветными рамками. Синяя рамка: обозначение, зеленая: наименование, желтая: тип документа, красная: все поля вместе." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,6,0,0">
          <Button Content="Выбрать папку…" Click="OnChooseFolder" />
          <Button Content="Как сделать шаблон" Click="OnHowTo" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Grid Name="Split" Grid.Row="2" ColumnDefinitions="300,*" ui:Gap.Columns="16">
      <Grid RowDefinitions="Auto,*,Auto" ui:Gap.Rows="8">
        <TextBox Name="SearchBox" Watermark="Поиск шаблона" />
        <!-- Список одной высоты: прокрутка внутри рамки, шаблонов может быть сотня. -->
        <Border Grid.Row="1" Classes="frame" MinHeight="160">
          <ListBox Name="List" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="s:TemplateItem">
                <Border BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="12,9">
                  <Grid ColumnDefinitions="Auto,*" ui:Gap.Columns="10">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{Binding Dot}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding FileName}" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Sub}" Classes="hint" Margin="0,2,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
        <!-- Сведения о выбранном шаблоне и кнопки друг под другом. -->
        <Border Grid.Row="2" Classes="card" Padding="12,2,12,12">
          <StackPanel>
            <Border Classes="kv"><Grid ColumnDefinitions="Auto,*" ui:Gap.Columns="12"><TextBlock Classes="muted" Text="Файл" /><TextBlock Name="InfoFile" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" /></Grid></Border>
            <Border Classes="kv"><Grid ColumnDefinitions="Auto,*" ui:Gap.Columns="12"><TextBlock Classes="muted" Text="Размер страницы" /><TextBlock Name="InfoSize" Grid.Column="1" TextAlignment="Right" /></Grid></Border>
            <Border Classes="kv"><Grid ColumnDefinitions="Auto,*" ui:Gap.Columns="12"><TextBlock Classes="muted" Text="Рамки" /><TextBlock Name="InfoFrames" Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap" /></Grid></Border>
            <StackPanel Spacing="8" Margin="0,12,0,0">
              <Button Name="OpenButton" Classes="full" Click="OnOpenTemplate">
                <StackPanel Orientation="Horizontal" Spacing="8"><ui:Icon Kind="FileText" /><TextBlock Text="Открыть шаблон" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Name="CheckButton" Classes="full" Click="OnCheckScan">
                <StackPanel Orientation="Horizontal" Spacing="8"><ui:Icon Kind="ScanText" /><TextBlock Text="Проверить скан…" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>

      <!-- Страница шаблона во всю высоту, вписана целиком. -->
      <Border Grid.Column="1" Background="{DynamicResource Brush.Viewer}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
              CornerRadius="8" ClipToBounds="True" Padding="16">
        <Panel>
          <Viewbox Stretch="Uniform">
            <Border Name="Sheet" Background="White" BoxShadow="0 1 3 0 #2E142034">
              <Image Name="Preview" Stretch="None" />
            </Border>
          </Viewbox>
          <TextBlock Name="PreviewNote" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Panel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
