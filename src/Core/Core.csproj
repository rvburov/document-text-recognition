<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ядро программы: шаблоны с цветными рамками, совмещение скана с шаблоном, распознавание
    двумя способами (Tesseract и PaddleOCR) со сверкой, имя файла и переименование. Окна здесь нет.

    Компоненты распознавания кладутся в папку ocr\ рядом с программой:
      ocr\paddle     модели PaddleOCR (вынимаются из пакета при сборке, около 13 МБ);
      ocr\tessdata   языковые данные Tesseract rus и eng (лежат в репозитории, папка ocr\tessdata);
      ocr\tesseract  Tesseract для Windows (из пакета TesseractOCR).
    На Linux (только проверки) Tesseract берется из системы.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>DocumentTextRecognition.Core</RootNamespace>
    <AssemblyName>DocumentTextRecognition.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocumentTextRecognition.Tests" />
    <InternalsVisibleTo Include="DocumentTextRecognition" />
    <InternalsVisibleTo Include="DocumentTextRecognition.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Страницы PDF в картинку: PDFium. -->
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <!-- Обработка изображений: рамки шаблона, совмещение, подготовка областей. -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <!-- PaddleOCR на движке Paddle Inference (CPU, OpenBLAS). -->
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <!-- Модели PaddleOCR v5: из пакета берутся только нужные, см. PaddleModels ниже. -->
    <PackageReference Include="Sdcb.PaddleOCR.Models.LocalV5" Version="3.3.1" ExcludeAssets="all" GeneratePathProperty="true" />
    <!-- Tesseract для Windows: готовые tesseract55.dll и leptonica (x64). -->
    <PackageReference Include="TesseractOCR" Version="5.5.2" ExcludeAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Нативные части для обеих платформ: публикация под win-x64 берет только свои
       (runtimes/win-x64/native), Linux нужен для проверок. -->
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.openblas" Version="3.3.1.70" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20261107" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.linux-x64.openblas" Version="3.3.1.70" />
  </ItemGroup>

  <!-- Tesseract для Windows кладется в ocr\tesseract (грузится только на Windows). -->
  <ItemGroup>
    <None Include="$(PkgTesseractOCR)\x64\tesseract55.dll" Link="ocr\tesseract\tesseract55.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgTesseractOCR)\x64\leptonica-1.85.0.dll" Link="ocr\tesseract\leptonica-1.85.0.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ocr\tessdata\*.traineddata" Link="ocr\tessdata\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Модели PaddleOCR: из пакета Sdcb.PaddleOCR.Models.LocalV5 вынимаются детектор mobile_zh_det
    и распознавание eslav_PP_OCRv5_mobile_rec (русский, латиница, цифры), около 13 МБ вместо 116.
    Вынимает их tools/ExtractPaddleModels.cs.
  -->
  <PropertyGroup>
    <PaddleModels>mobile_zh_det;eslav_PP_OCRv5_mobile_rec</PaddleModels>
    <PaddleModelsDir>$(MSBuildProjectDirectory)/../../artifacts/ocr-models/paddle-v5</PaddleModelsDir>
    <PaddleModelsSource>$(PkgSdcb_PaddleOCR_Models_LocalV5)\lib\netstandard2.0\Sdcb.PaddleOCR.Models.LocalV5.dll</PaddleModelsSource>
  </PropertyGroup>

  <Target Name="DtrPaddleModels" BeforeTargets="AssignTargetPaths"
          Inputs="$(PaddleModelsSource)" Outputs="$(PaddleModelsDir)\eslav_PP_OCRv5_mobile_rec\inference.pdiparams">
    <Exec Command="dotnet run --file &quot;$(MSBuildProjectDirectory)/../../tools/ExtractPaddleModels.cs&quot; -- &quot;$(PaddleModelsSource)&quot; &quot;$(PaddleModelsDir)&quot; &quot;$(PaddleModels)&quot;" />
  </Target>

  <Target Name="DtrPaddleModelItems" BeforeTargets="AssignTargetPaths" DependsOnTargets="DtrPaddleModels">
    <ItemGroup>
      <_DtrPaddleModel Include="$(PaddleModelsDir)/**/*" />
      <None Include="@(_DtrPaddleModel)"
            Link="ocr/paddle/%(_DtrPaddleModel.RecursiveDir)%(_DtrPaddleModel.Filename)%(_DtrPaddleModel.Extension)"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
